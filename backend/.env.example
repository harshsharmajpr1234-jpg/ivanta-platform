# ============ iVanta backend environment ============
# Copy to .env (never commit .env) or export in your shell / IDE run config.

# --- MySQL (XAMPP / Production defaults) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ivanta
DB_USERNAME=root
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- First SUPER_ADMIN bootstrap (used once, when no admin exists) ---
# Provided via deployment secrets. Generate strong password; do NOT commit.
IVANTA_INITIAL_ADMIN_EMAIL=
IVANTA_INITIAL_ADMIN_PASSWORD=
ADMIN_ROOT_NAME=iVanta Root Admin

# Set to true ONLY on a local dev machine to seed demo role admins.
DEV_SEED_DEMO_ADMINS=false

# --- Sessions / lockout ---
ADMIN_SESSION_TTL_MINUTES=30
USER_SESSION_TTL_HOURS=8
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15

# --- Dev OTP (mock provider only) ---
DEV_OTP_CODE=123456

# --- Checkout / orders ---
RESERVATION_TTL_MINUTES=15
COD_ENABLED=true
MIN_ORDER_VALUE=999
RETURN_WINDOW_DAYS=3

# --- Payments (mock | razorpay) ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MOCK_SECRET=dev-only-mock-secret-change-me

# --- Logistics & Courier (mock | shiprocket | delhivery) ---
DELIVERY_PROVIDER=shiprocket
DELIVERY_AUTO_SHIP=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=Primary Warehouse

# --- Location & Reverse Geocoding (dataset | osm | google) ---
GEO_PROVIDER=osm

# --- Misc ---
UPLOAD_DIR=./uploads

# ============ frontend/.env.local ============
# NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
