# Copy to .env.local
# Browser-facing API base. Use the same-origin dev proxy (/api/v1) in development,
# or the full public origin in production (e.g. https://api.ivanta.in/api/v1).
NEXT_PUBLIC_API_BASE=/api/v1
# Server-side only: where the dev proxy forwards requests (Spring Boot).
BACKEND_ORIGIN=http://127.0.0.1:8080
